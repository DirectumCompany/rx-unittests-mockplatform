<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MockPlatform</RootNamespace>
    <AssemblyName>Server.Tests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="NUnit" Version="3.14.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(AppliedModulesPath)\*.dll" />
    <Reference Include="$(LibWebServerPath)\*.dll" />
    <Reference Include="$(LibWebServerPath)\*IsolatedArea*.dll">
      <Aliases>IsolatedArea</Aliases>
    </Reference>
    <Reference Include="$(LibWebServerPath)\*ClientBase.dll">
      <Aliases>ClientBase</Aliases>
    </Reference>
  </ItemGroup>
</Project>
